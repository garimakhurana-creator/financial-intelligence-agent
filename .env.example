# Copy to .env.local and fill in. Never commit real values.
# Every key here is server-only — none use the NEXT_PUBLIC_ prefix.

# --- Appwrite (TablesDB) ---
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=mf_tracker
# Server API key with scopes: databases.read/write, tables.read/write, rows.read/write, columns.read/write, indexes.read/write
APPWRITE_API_KEY=

# --- AI (Gemini Flash only) ---
GEMINI_API_KEY=
# Optional override; otherwise the newest available "flash" model is picked from the models list
GEMINI_MODEL=

# --- News ---
TAVILY_API_KEY=

# --- Security ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Password for admin actions (add/remove fund, generate report, test sends)
ADMIN_PASSWORD=

# --- Email (Resend) ---
RESEND_API_KEY=
# Without a verified domain Resend only allows onboarding@resend.dev -> your own account email
REPORT_EMAIL_FROM="Meera Fund Report <onboarding@resend.dev>"
REPORT_EMAIL_TO=

# --- Telegram (Bot API) ---
# Create a bot with @BotFather; send /start to it, then run scripts/telegram-chat-id.ts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp click-to-chat (manual one-tap share; NOT automated delivery) ---
# Owner's number for "Send to my WhatsApp" (digits with country code). Shown only to the
# signed-in owner and inside the private Telegram message, never on public pages.
WHATSAPP_SHARE_NUMBER=

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# E.164 without "+", e.g. 919876543210
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to yes once the recipient has opted in to messages from this business number
WHATSAPP_RECIPIENT_OPTED_IN=
# Graph API version, e.g. v23.0 — set to the version shown in your Meta app dashboard
WHATSAPP_GRAPH_VERSION=
# Token you choose; Meta sends it when verifying the status webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret from Meta app settings, used to verify webhook signatures
WHATSAPP_APP_SECRET=

# --- App ---
# Public base URL used in email/WhatsApp links, e.g. https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000
REPORT_TIMEZONE=Asia/Kolkata
